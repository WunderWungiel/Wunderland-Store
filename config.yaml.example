# Required: generate a random signing key before starting the app.
secret_key: ""
# Public URL used for confirmation emails, feeds and client links.
base_url: "http://ovi.wunderwungiel.pl"
# The POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER and
# POSTGRES_PASSWORD environment variables override these when set. Docker
# compose sets them from .env, so in Docker this section can be left out.
database:
  host: "localhost"
  port: 5432
  name: "wunderland"
  user: "postgres"
  password: "change-me"
email:
  address: "email@address.com"
  password: ""
  smtp:
    port: 465
    address: ""
# Directory with the uploaded files, icons, screenshots and news, served at
# /static/content/. A relative path is resolved against the repo root.
content_dir: "content"
allow_indexing: true
per_page: 10
platforms:
  qtstore:
    - 's60v3'
    - 's60'
  client:
    - 's60'
    - 'symbian3'
clients:
  - 16
  - 192
