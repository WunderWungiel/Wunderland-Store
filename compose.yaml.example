services:
  app:
    build:
      context: .
      args:
        APP_UID: ${APP_UID:-1000}
        APP_GID: ${APP_GID:-1000}
    container_name: wunderland
    environment:
      TZ: Etc/UTC
    volumes:
      - ./config.yaml:/srv/config.yaml:ro
      - ./content:/srv/content
    depends_on:
      db:
        condition: service_healthy
    expose:
      - "8000"
    stop_signal: SIGINT
    stop_grace_period: 15s
    restart: unless-stopped

  # Deletes expired unconfirmed users and sessions once a day.
  clean:
    build:
      context: .
      args:
        APP_UID: ${APP_UID:-1000}
        APP_GID: ${APP_GID:-1000}
    container_name: wunderland-clean
    environment:
      TZ: Etc/UTC
    volumes:
      - ./config.yaml:/srv/config.yaml:ro
    command: ["sh", "-c", "while true; do flask --app wunderland.app clean; sleep 86400; done"]
    # Lets the container stop at once instead of waiting out the sleep.
    init: true
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped

  proxy:
    image: nginx:stable-alpine
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    ports:
      # A reverse proxy on this host can connect to localhost:8080.
      # For a remote proxy, bind a reachable address and restrict access to its IP.
      - "127.0.0.1:8080:80"
    depends_on:
      - app
    restart: unless-stopped

  db:
    image: postgres:18
    container_name: wunderland-db
    environment:
      TZ: Etc/UTC
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - db_data:/var/lib/postgresql
      - ./db/schema.sql:/docker-entrypoint-initdb.d/schema.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 5
    stop_signal: SIGINT
    stop_grace_period: 30s
    restart: unless-stopped

volumes:
  db_data:
