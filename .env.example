# Copy to .env. docker compose reads it automatically.

# Host address and port the nginx proxy listens on. Keep 127.0.0.1 when the
# public reverse proxy runs on this host.
BIND_ADDRESS=127.0.0.1
PORT=8080

# Time zone for all containers (logs, cleanup timing).
TZ=Etc/UTC

# Gunicorn worker processes in the app container.
WEB_CONCURRENCY=8

# UID/GID the app containers run as. The host's ./content directory must be
# writable by this user for admin uploads to work.
APP_UID=1000
APP_GID=1000

# PostgreSQL database created on the first start (only when the db volume is
# empty). The app containers connect with these too; config.yaml has no
# database settings.
POSTGRES_DB=wunderland
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Only used when running the app without Docker, where compose doesn't point
# it at the db container. Empty POSTGRES_HOST means the local Unix socket.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
